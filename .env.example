# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lead dispatch: mock (log only) | live (send email)
LEAD_DISPATCH_MODE=mock
EMAIL_PROVIDER=resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=true
SEND_CLIENT_CONFIRMATION=true
WEBHOOK_URL=
RATE_LIMIT_PER_MINUTE=5
MAX_UPLOAD_MB=4
SHOW_IP_IN_EMAIL=false

# Testing only: send through a local stand-in instead of the real Resend API. Leave unset.
# RESEND_API_URL=
